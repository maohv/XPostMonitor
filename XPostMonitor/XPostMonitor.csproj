<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.9" />
    <PackageReference Include="Nethereum.Web3" Version="6.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Không đưa bản publish cũ quay ngược vào bản publish mới. -->
    <Content Remove="publish\**\*" />
    <Content Update="appsettings.Development.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Update="Localization\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\ChainLogos\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\CharacterReferences\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\CharacterReferences\*.jpg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\CharacterReferences\*.jpeg" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Assets\flap-payment-tokens.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
